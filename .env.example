# ==============================================================================
# Z-BITS ENVIRONMENT CONFIGURATION
# Tagline: Your agents. Your rules. Your money.
# ==============================================================================

# --- AI Provider Configurations ---
# Google Gemini (official @google/genai SDK)
GEMINI_API_KEY=

# AWS Bedrock (Converse API @aws-sdk/client-bedrock-runtime)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional session token if using temporary STS credentials
AWS_SESSION_TOKEN=

# Generic OpenAI-Compatible Endpoints (Groq, Together, DeepSeek, Local Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API Key (if not using local Claude Code)
ANTHROPIC_API_KEY=

# --- Z-Bits Gate Deterministic Financial Safety Engine ---
# Cryptographic secret used to sign approved purchase intents (HMAC-SHA256)
GATE_SIGNING_SECRET=zbits-gate-deterministic-secret-key-change-in-production

# Default Gate spending limits (in cents, e.g. 5000 = $50.00)
GATE_MAX_PER_TRANSACTION_CENTS=5000
GATE_DAILY_BUDGET_CENTS=15000
GATE_MONTHLY_BUDGET_CENTS=50000
GATE_APPROVAL_THRESHOLD_CENTS=2000

# --- Runner Commerce Integrations (Isolated from LLMs) ---
# Bitrefill Commerce (Gift cards & prepaid utilities)
BITREFILL_API_KEY=
BITREFILL_API_SECRET=

# Zcash Shielded Settlement (Node / Lightwalletd URL)
ZCASH_LIGHTWALLETD_URL=

# --- Server & Deployment Settings ---
OPENBOT_PORT=4311
OPENBOT_DEPLOYMENT_MODE=local
OPENBOT_APP_URL=
OPENBOT_DATA_DIR=

# Shared token allowance per job (range: 1000–2000000)
OPENBOT_JOB_MAX_TOKENS=100000

# Optional release-managed Google OAuth client
OPENBOT_GOOGLE_CLIENT_ID=
OPENBOT_GOOGLE_CLIENT_SECRET=

# Optional release-managed Slack OAuth app
OPENBOT_SLACK_CLIENT_ID=
OPENBOT_SLACK_CLIENT_SECRET=
OPENBOT_SLACK_SIGNING_SECRET=

# Optional release-managed public Notion integration
OPENBOT_NOTION_CLIENT_ID=
OPENBOT_NOTION_CLIENT_SECRET=
OPENBOT_NOTION_VERIFICATION_TOKEN=

# Optional release-managed Dropbox OAuth app
OPENBOT_DROPBOX_APP_KEY=
OPENBOT_DROPBOX_CLIENT_SECRET=

# Optional native mobile push delivery
OPENBOT_APNS_TEAM_ID=
OPENBOT_APNS_KEY_ID=
OPENBOT_APNS_PRIVATE_KEY_PATH=
OPENBOT_APNS_BUNDLE_ID=app.zbits.mobile

# Optional remote relay access
OPENBOT_RELAY_URL=
OPENBOT_RELAY_ENROLLMENT_TOKEN=
